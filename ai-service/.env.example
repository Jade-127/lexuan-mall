# 复制成 .env 后填入自己的 Key，.env 不要提交到 git
DASHSCOPE_API_KEY=sk-在这里填你的百炼Key
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
CHAT_MODEL=qwen-plus
EMBED_MODEL=text-embedding-v3
APP_PORT=8087

# --- 链路追踪（可选）---
# 默认不开启：日志写在 logs/traces.jsonl，用 GET /ai/traces/{trace_id} 回放
# 想接 LangSmith 可视化：去 smith.langchain.com 拿 Key，把下面三行取消注释，重启服务即可
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_在这里填
# LANGSMITH_PROJECT=lexuan-agent
